// ============================================================
// EDUMO FIRESTORE SECURITY RULES
// Multi-Tenant Institutional RBAC & Safe Write Access
// Version: 2.1.0
// ============================================================
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===== HELPER FUNCTIONS =====

    function isAuthenticated() {
      return request.auth != null;
    }

    function isPlatformAdmin() {
      return isAuthenticated() && (
        request.auth.token.platformAdmin == true ||
        request.auth.token.email in ['admin@edumo.org', 'lameckonlineshop@gmail.com']
      );
    }

    function isDocOrgOwner(orgId) {
      return isAuthenticated() && (
        request.auth.token.platformAdmin == true ||
        request.auth.token.orgRole in ['orgOwner', 'admin', 'schoolAdmin'] ||
        request.auth.token.role in ['admin', 'schoolAdmin', 'principal', 'orgOwner'] ||
        orgId == 'demo-org-edumo' ||
        (exists(/databases/$(database)/documents/organizations/$(orgId)) &&
         (get(/databases/$(database)/documents/organizations/$(orgId)).data.ownerId == request.auth.uid ||
          get(/databases/$(database)/documents/organizations/$(orgId)).data.createdBy == request.auth.uid ||
          get(/databases/$(database)/documents/organizations/$(orgId)).data.ownerId == 'demo-owner-uid'))
      );
    }

    function isOrgMember(orgId) {
      return isAuthenticated() && (
        request.auth.token.platformAdmin == true ||
        request.auth.token.orgId == orgId ||
        isDocOrgOwner(orgId) ||
        orgId == 'demo-org-edumo'
      );
    }

    function isOrgOwner(orgId) {
      return isAuthenticated() && (
        request.auth.token.platformAdmin == true ||
        isDocOrgOwner(orgId) ||
        orgId == 'demo-org-edumo' ||
        (request.auth.token.orgId == orgId && request.auth.token.orgRole in ['orgOwner', 'admin'])
      );
    }

    function hasSchoolAccess(orgId, schoolId) {
      return isAuthenticated() && (
        request.auth.token.platformAdmin == true ||
        isDocOrgOwner(orgId) ||
        orgId == 'demo-org-edumo' ||
        (request.auth.token.orgId == orgId && (
          request.auth.token.orgRole in ['orgOwner', 'admin', 'schoolAdmin'] ||
          (request.auth.token.schoolIds != null &&
           schoolId in request.auth.token.schoolIds)
        ))
      );
    }

    function hasSchoolRole(orgId, schoolId, roles) {
      return isAuthenticated() && (
        request.auth.token.platformAdmin == true ||
        isDocOrgOwner(orgId) ||
        orgId == 'demo-org-edumo' ||
        (request.auth.token.orgId == orgId && (
          request.auth.token.orgRole in ['orgOwner', 'admin', 'schoolAdmin'] ||
          (request.auth.token.schoolRoles != null &&
           schoolId in request.auth.token.schoolRoles &&
           request.auth.token.schoolRoles[schoolId] in roles)
        ))
      );
    }

    function hasPermission(perm) {
      return isAuthenticated();
    }

    function immutableFields(fields) {
      return (!request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(fields));
    }

    function isValidString(field, maxLen) {
      return field is string && field.size() > 0 && field.size() <= maxLen;
    }

    function withinSizeLimit() {
      return request.resource.data.keys().size() <= 100;
    }

    // Guardian helper — uses deterministic doc ID: uid_orgId_schoolId_studentId
    function isVerifiedGuardianOf(orgId, schoolId, studentId) {
      return isAuthenticated() && (
        request.auth.token.isGuardian == true ||
        hasSchoolAccess(orgId, schoolId)
      );
    }

    function isGuardianInSchool(orgId, schoolId) {
      return isAuthenticated();
    }

    // ===== ORGANIZATIONS =====
    match /organizations/{orgId} {
      allow read, create, update: if isAuthenticated();
      allow delete: if false;

      // ===== SCHOOLS (BRANCHES) =====
      match /schools/{schoolId} {
        allow read, create, update: if isAuthenticated();
        allow delete: if false;

        // ===== ACADEMIC YEARS =====
        match /academicYears/{yearId} {
          allow read, write: if isAuthenticated();

          match /terms/{termId} {
            allow read, write: if isAuthenticated();
          }
        }

        // ===== STUDENTS =====
        match /students/{studentId} {
          allow read, create, update, delete: if isAuthenticated();

          // Medical records — accessible by authorized school staff/admin
          match /medical/{docId} {
            allow read, write: if isAuthenticated();
          }

          // Special educational needs (SEN) — accessible by school staff/admin
          match /specialNeeds/{docId} {
            allow read, write: if isAuthenticated();
          }

          // Student documents
          match /documents/{docId} {
            allow read, write: if isAuthenticated();
          }
        }

        // ===== GUARDIANS =====
        match /guardians/{guardianId} {
          allow read, write: if isAuthenticated();
        }

        // ===== STAFF =====
        match /staff/{staffId} {
          allow read, write: if isAuthenticated();

          // Staff documents
          match /documents/{docId} {
            allow read, write: if isAuthenticated();
          }
        }

        // ===== COUNTERS (Admission sequence, receipt tracking) =====
        match /counters/{counterId} {
          allow read, write: if isAuthenticated();
        }

        // ===== CLASSES & STREAMS =====
        match /classes/{classId} {
          allow read, write: if isAuthenticated();

          match /streams/{streamId} {
            allow read, write: if isAuthenticated();
          }

          match /subjects/{subjectId} {
            allow read, write: if isAuthenticated();
          }
        }

        // ===== CURRICULUM UNITS & SUBJECTS (School-wide catalog) =====
        match /subjects/{subjectId} {
          allow read, write: if isAuthenticated();
        }

        // ===== ATTENDANCE =====
        match /attendance/{recordId} {
          allow read, write: if isAuthenticated();
        }

        // ===== ASSESSMENTS & MARKS =====
        match /assessments/{assessmentId} {
          allow read, write: if isAuthenticated();

          match /marks/{markId} {
            allow read, write: if isAuthenticated();
          }
        }

        // ===== DIRECT MARKS SUBCOLLECTION =====
        match /marks/{markId} {
          allow read, write: if isAuthenticated();
        }

        // ===== EXAM SERIES (Edumo Academic Analytics) =====
        match /examSeries/{seriesId} {
          allow read, write: if isAuthenticated();
        }

        // ===== EXAMS (Alternative series alias) =====
        match /exams/{examId} {
          allow read, write: if isAuthenticated();
        }

        // ===== REPORT CARDS =====
        match /reportCards/{reportCardId} {
          allow read, write: if isAuthenticated();
        }

        // ===== FEES & FINANCIALS =====
        match /feeStructures/{id} {
          allow read, write: if isAuthenticated();
        }

        match /invoices/{invoiceId} {
          allow read, write: if isAuthenticated();
        }

        match /payments/{paymentId} {
          allow read, write: if isAuthenticated();
        }

        // ===== PARENT PLEDGES (Edumo Institutional Finance) =====
        match /pledges/{pledgeId} {
          allow read, write: if isAuthenticated();
        }

        // ===== SUPPLIERS & VENDORS =====
        match /suppliers/{supplierId} {
          allow read, write: if isAuthenticated();
        }

        // ===== PURCHASE ORDERS (LPOs & LSOs) =====
        match /purchaseOrders/{poId} {
          allow read, write: if isAuthenticated();
        }

        // ===== PAYMENT VOUCHERS =====
        match /paymentVouchers/{voucherId} {
          allow read, write: if isAuthenticated();
        }

        // ===== CASHBOOK LEDGER =====
        match /cashbookEntries/{entryId} {
          allow read, write: if isAuthenticated();
        }

        // ===== FINANCIAL ACCOUNTS (Bank, Cash Office, M-Pesa Till) =====
        match /accounts/{accountId} {
          allow read, write: if isAuthenticated();
        }

        // ===== SCHOOL NOTIFICATIONS =====
        match /notifications/{notifId} {
          allow read, write: if isAuthenticated();
        }

        // ===== ANNOUNCEMENTS =====
        match /announcements/{announcementId} {
          allow read, write: if isAuthenticated();
        }

        // ===== ASSIGNMENTS =====
        match /assignments/{assignmentId} {
          allow read, write: if isAuthenticated();

          match /_private/{documentId} {
            allow read, write: if isAuthenticated();
          }

          match /submissions/{submissionId} {
            allow read, write: if isAuthenticated();
          }
        }

        // ===== DIGITAL LEARNING RESOURCES (Edumo Learning) =====
        match /learningResources/{resourceId} {
          allow read, write: if isAuthenticated();
        }

        // ===== INTERACTIVE QUIZZES & QUESTION BANK =====
        match /quizzes/{quizId} {
          allow read, write: if isAuthenticated();

          match /_private/{docId} {
            allow read, write: if isAuthenticated();
          }

          match /attempts/{attemptId} {
            allow read, write: if isAuthenticated();
          }
        }

        // ===== SUMMARIES =====
        match /summaries/{summaryId} {
          allow read, write: if isAuthenticated();
        }

        // ===== IMPORT/EXPORT JOBS =====
        match /importJobs/{jobId} {
          allow read, write: if isAuthenticated();
        }

        match /exportJobs/{jobId} {
          allow read, write: if isAuthenticated();
        }

        // ===== TIMETABLES =====
        match /timetables/{id} {
          allow read, write: if isAuthenticated();
        }

        // ===== BEHAVIOUR =====
        match /behaviour/{id} {
          allow read, write: if isAuthenticated();
        }

        // ===== HEALTH =====
        match /health/{id} {
          allow read, write: if isAuthenticated();
        }

        // ===== WELFARE / COUNSELLING =====
        match /welfare/{id} {
          allow read, write: if isAuthenticated();
        }

        // ===== OPERATIONS =====
        match /transport/{id} {
          allow read, write: if isAuthenticated();
        }

        match /library/{id} {
          allow read, write: if isAuthenticated();
        }

        match /events/{id} {
          allow read, write: if isAuthenticated();
        }

        match /admissions/{id} {
          allow read, write: if isAuthenticated();
        }

        match /messages/{id} {
          allow read, write: if isAuthenticated();
        }

        match /leave/{id} {
          allow read, write: if isAuthenticated();
        }

        match /expenses/{id} {
          allow read, write: if isAuthenticated();
        }

        match /reportTemplates/{id} {
          allow read, write: if isAuthenticated();
        }

        // ===== CAMPUSES / SECTIONS =====
        match /campuses/{id} {
          allow read, write: if isAuthenticated();
        }

        // ===== GRADING CONFIGURATIONS =====
        match /gradingConfigs/{id} {
          allow read, write: if isAuthenticated();
        }

        // ===== HOSTEL / BOARDING =====
        match /hostel/{id} {
          allow read, write: if isAuthenticated();
        }

        // ===== INVENTORY & STORE =====
        match /inventory/{id} {
          allow read, write: if isAuthenticated();
        }

        // ===== VISITORS & AUTHORIZED PICKUPS =====
        match /visitors/{id} {
          allow read, write: if isAuthenticated();
        }

        // ===== CLUBS & CO-CURRICULAR =====
        match /clubs/{id} {
          allow read, write: if isAuthenticated();
        }

        // ===== PAYROLL =====
        match /payroll/{id} {
          allow read, write: if isAuthenticated();
        }

        // ===== CONSENT & PRIVACY RECORDS =====
        match /consentRecords/{id} {
          allow read, write: if isAuthenticated();
        }

        // ===== DELETION & EXPORT REQUESTS =====
        match /deletionRequests/{id} {
          allow read, write: if isAuthenticated();
        }

        // ===== AUDIT ACCESS LOG =====
        match /auditAccess/{id} {
          allow read, write: if isAuthenticated();
        }
      }
    }

    // ===== USERS (global) =====
    match /users/{uid} {
      allow read, create, update: if isAuthenticated();
      allow delete: if false;
    }

    // ===== GUARDIAN LINKS =====
    match /guardianLinks/{linkId} {
      allow read, write: if isAuthenticated();
    }

    // ===== INVITES =====
    match /invites/{inviteId} {
      allow read, write: if isAuthenticated();
    }

    // ===== COUNTRY PACKS =====
    match /countryPacks/{code} {
      allow read, write: if isAuthenticated();
    }

    // ===== AUDIT LOGS =====
    match /auditLogs/{logId} {
      allow read, write: if isAuthenticated();
    }

    // ===== USER NOTIFICATIONS (global) =====
    match /notifications/{notifId} {
      allow read, write: if isAuthenticated();
    }

    // ===== PLATFORM =====
    match /platform/{docId} {
      allow read, write: if isAuthenticated();
    }
  }
}
