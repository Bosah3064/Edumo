rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ===== DENY ALL BY DEFAULT =====
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // ===== HELPER FUNCTIONS =====
    function isAuthenticated() {
      return request.auth != null;
    }

    function isPlatformAdmin() {
      return isAuthenticated() &&
        request.auth.token.platformAdmin == true;
    }

    function isOrgMember(orgId) {
      return isAuthenticated() &&
        request.auth.token.orgId == orgId;
    }

    function hasSchoolAccess(orgId, schoolId) {
      return isOrgMember(orgId) && (
        request.auth.token.orgRole == 'orgOwner' ||
        (request.auth.token.schoolIds != null &&
         schoolId in request.auth.token.schoolIds)
      );
    }

    function isImageType() {
      return request.resource.contentType.matches('image/(jpeg|png|webp|gif)');
    }

    function isDocumentType() {
      return request.resource.contentType.matches(
        '(application/(pdf|vnd\\.openxmlformats-officedocument\\.spreadsheetml\\.sheet|vnd\\.ms-excel)|image/(jpeg|png|webp))');
    }

    function isSpreadsheetType() {
      return request.resource.contentType.matches(
        'application/vnd\\.openxmlformats-officedocument\\.spreadsheetml\\.sheet');
    }

    // 5 MB for photos
    function isUnderPhotoLimit() {
      return request.resource.size < 5 * 1024 * 1024;
    }

    // 25 MB for documents
    function isUnderDocLimit() {
      return request.resource.size < 25 * 1024 * 1024;
    }

    // 50 MB for imports
    function isUnderImportLimit() {
      return request.resource.size < 50 * 1024 * 1024;
    }

    // ===== ORG-LEVEL BRANDING =====
    match /{orgId}/branding/{filename} {
      allow read: if isOrgMember(orgId) || isPlatformAdmin();
      allow write: if isOrgMember(orgId) &&
        request.auth.token.orgRole == 'orgOwner' &&
        isImageType() &&
        isUnderPhotoLimit();
    }

    // ===== SCHOOL-LEVEL FILES =====

    // Student photos
    match /{orgId}/{schoolId}/students/{studentId}/photos/{filename} {
      allow read: if hasSchoolAccess(orgId, schoolId);
      allow write: if hasSchoolAccess(orgId, schoolId) &&
        isImageType() &&
        isUnderPhotoLimit();
    }

    // Student documents
    match /{orgId}/{schoolId}/students/{studentId}/documents/{filename} {
      allow read: if hasSchoolAccess(orgId, schoolId);
      allow write: if hasSchoolAccess(orgId, schoolId) &&
        isDocumentType() &&
        isUnderDocLimit();
    }

    // Staff photos
    match /{orgId}/{schoolId}/staff/{staffId}/photos/{filename} {
      allow read: if hasSchoolAccess(orgId, schoolId);
      allow write: if hasSchoolAccess(orgId, schoolId) &&
        isImageType() &&
        isUnderPhotoLimit();
    }

    // Imports — upload by authorized staff
    match /{orgId}/{schoolId}/imports/{jobId}/{filename} {
      allow read: if hasSchoolAccess(orgId, schoolId);
      allow write: if hasSchoolAccess(orgId, schoolId) &&
        isSpreadsheetType() &&
        isUnderImportLimit();
    }

    // Exports — written by Cloud Functions, read via signed URLs only
    match /{orgId}/{schoolId}/exports/{jobId}/{filename} {
      allow read: if false;
      allow write: if false;
    }

    // Reports (PDFs etc.) — written by Cloud Functions, read via signed URLs
    match /{orgId}/{schoolId}/reports/{filename} {
      allow read: if false;
      allow write: if false;
    }

    // Announcement attachments
    match /{orgId}/{schoolId}/announcements/{announcementId}/{filename} {
      allow read: if hasSchoolAccess(orgId, schoolId);
      allow write: if hasSchoolAccess(orgId, schoolId) &&
        (isImageType() || isDocumentType()) &&
        isUnderDocLimit();
    }

    // School branding
    match /{orgId}/{schoolId}/branding/{filename} {
      allow read: if hasSchoolAccess(orgId, schoolId);
      allow write: if hasSchoolAccess(orgId, schoolId) &&
        isImageType() &&
        isUnderPhotoLimit();
    }
  }
}
